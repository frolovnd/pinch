# Проверка локализации: ключи в коде и таблицах согласованы, в коде нет «сырых» пользовательских строк.
# Запуск: cmake -DSRC=<корень проекта> -P check_i18n.cmake
cmake_policy(VERSION 3.16)
if(NOT SRC)
    message(FATAL_ERROR "check_i18n: не задан -DSRC")
endif()

set(errors "")
macro(fail msg)
    list(APPEND errors "${msg}")
endmacro()

file(GLOB code_files "${SRC}/src/*.cpp" "${SRC}/src/*.h")

# 1. Ключи, использованные в коде (qtTrId и QT_TRID_NOOP).
set(used "")
foreach(f ${code_files})
    file(READ "${f}" text)
    string(REGEX MATCHALL "(qtTrId|QT_TRID_NOOP)\\(\"[^\"]+\"" hits "${text}")
    foreach(h ${hits})
        string(REGEX REPLACE "^[A-Za-z_]+\\(\"([^\"]+)\"$" "\\1" key "${h}")
        list(APPEND used "${key}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES used)
list(SORT used)

# 2. Таблицы: заполняет <prefix>_IDS и ошибки о пустых/незавершённых переводах.
function(read_ts file prefix)
    file(READ "${file}" xml)
    string(REPLACE ";" "<SEMI>" xml "${xml}")
    string(REPLACE "</message>" "</message>;" xml "${xml}")
    set(ids "")
    set(bad "")
    foreach(chunk ${xml})
        if(NOT chunk MATCHES "<message id=\"([^\"]+)\"")
            continue()
        endif()
        set(id "${CMAKE_MATCH_1}")
        list(APPEND ids "${id}")
        if(NOT chunk MATCHES "<translation[^>]*>[^<]+</translation>")
            list(APPEND bad "${file}: у ключа ${id} пустой перевод")
        endif()
        if(chunk MATCHES "<translation[^>]*type=\"unfinished\"")
            list(APPEND bad "${file}: у ключа ${id} незавершённый перевод (unfinished)")
        endif()
    endforeach()
    list(SORT ids)
    set(${prefix}_IDS "${ids}" PARENT_SCOPE)
    set(${prefix}_BAD "${bad}" PARENT_SCOPE)
endfunction()

read_ts("${SRC}/translations/pinch_en.ts" en)
read_ts("${SRC}/translations/pinch_ru.ts" ru)
foreach(e ${en_BAD} ${ru_BAD})
    fail("${e}")
endforeach()

# 3. Согласованность ключей.
foreach(k ${used})
    if(NOT k IN_LIST en_IDS)
        fail("ключ ${k} используется в коде, но отсутствует в pinch_en.ts")
    endif()
    if(NOT k IN_LIST ru_IDS)
        fail("ключ ${k} используется в коде, но отсутствует в pinch_ru.ts")
    endif()
endforeach()
foreach(k ${en_IDS})
    if(NOT k IN_LIST ru_IDS)
        fail("ключ ${k} есть в pinch_en.ts, но нет в pinch_ru.ts")
    endif()
    if(NOT k IN_LIST used)
        fail("ключ ${k} не используется в коде (лишний в таблицах)")
    endif()
endforeach()
foreach(k ${ru_IDS})
    if(NOT k IN_LIST en_IDS)
        fail("ключ ${k} есть в pinch_ru.ts, но нет в pinch_en.ts")
    endif()
endforeach()

# 4 и 5. Кириллица в строковых литералах и вызовы tr()/translate().
foreach(f ${code_files})
    # Построчный разбор через список: прячем символы, которые CMake трактует как разделители/скобки списка.
    file(READ "${f}" body)
    string(REPLACE ";" "<SEMI>" body "${body}")
    string(REPLACE "[" "<LB>" body "${body}")
    string(REPLACE "]" "<RB>" body "${body}")
    string(REPLACE "\n" ";" lines "${body}")
    foreach(line ${lines})
        string(REGEX REPLACE "//.*$" "" code "${line}")
        # Диапазоны [А-я] в CMake побайтовые и дают ложные срабатывания на ×, ✎ и т.п., поэтому — перечень букв.
        if(code MATCHES "\"[^\"]*(А|Б|В|Г|Д|Е|Ё|Ж|З|И|Й|К|Л|М|Н|О|П|Р|С|Т|У|Ф|Х|Ц|Ч|Ш|Щ|Ъ|Ы|Ь|Э|Ю|Я|а|б|в|г|д|е|ё|ж|з|и|й|к|л|м|н|о|п|р|с|т|у|ф|х|ц|ч|ш|щ|ъ|ы|ь|э|ю|я)[^\"]*\"")
            fail("${f}: кириллица в строковом литерале: ${line}")
        endif()
        if(code MATCHES "(^|[^A-Za-z0-9_])(tr|QObject::tr|QCoreApplication::translate)\\(")
            fail("${f}: вызов tr()/translate() запрещён, используйте qtTrId: ${line}")
        endif()
    endforeach()
endforeach()

if(errors)
    string(REPLACE ";" "\n  " report "${errors}")
    message(FATAL_ERROR "check_i18n: найдены проблемы:\n  ${report}")
endif()
list(LENGTH used n_used)
message(STATUS "check_i18n: OK, ключей: ${n_used}")
